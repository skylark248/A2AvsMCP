# Optional OpenAI-backed runtime. Leave unset for deterministic mock mode.
OPENAI_API_KEY=

# Optional profile override: dev, demo, or llm.
A2A_VS_MCP_PROFILE=dev

# Optional MCP transport override: in_process, stdio, http, or remote_http.
MCP_TRANSPORT=in_process

# Optional remote MCP endpoint URLs for remote_http runs.
REMOTE_MCP_DB_URL=http://127.0.0.1:9001/mcp
REMOTE_MCP_DOCS_URL=http://127.0.0.1:9002/mcp

# Optional A2A transport override: local or remote.
A2A_TRANSPORT=local

# Optional remote A2A specialist URLs for remote runs.
REMOTE_A2A_CUSTOMER_URL=http://127.0.0.1:9101
REMOTE_A2A_DOCUMENTATION_URL=http://127.0.0.1:9102
REMOTE_A2A_POLICY_URL=http://127.0.0.1:9103
REMOTE_A2A_TOKEN=

# Keep false/empty for local demos. Set true only in trusted deployments that intentionally call external remote MCP/A2A hosts.
A2A_VS_MCP_ALLOW_EXTERNAL_REMOTE_URLS=


# Optional artifact root override. Useful for tests and throwaway demo state.
A2A_VS_MCP_ARTIFACT_ROOT=
